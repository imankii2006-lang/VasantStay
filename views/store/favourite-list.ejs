<%- include('../partials/head') %>
  <link rel="stylesheet" href="/css/home-list.css" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link rel="stylesheet" href="/css/navbar.css">
<link rel="stylesheet" href="/css/responsive.css">
</head>
<body>
  <%- include('../partials/nav') %>
  
  <main>
    <h1 class="welcome-text">Your Wishlist</h1>
    
    <div class="homes-container">
      <% favouriteHomes.forEach(home => { %>
        <div class="home-card">
          <div class="image-container">
            <img src="<%= home.photo %>" alt="<%= home.housename %>">
          </div>
          <div class="home-details">
            <h2 class="house-name"><%= home.housename %></h2>
            <p class="location"><%= home.location %></p>
            <div class="price-rating">
              <span class="price">Rs<%= home.price %> / night</span>
              <span class="rating">⭐ <%= home.rating %></span>
            </div>
            <form action="/favourites/delete/<%= home._id %>" method="POST">
              <button 
                type="submit" 
                style="
                
  border: 1px solid black;
  color: black;
  background-color: fff5f5;
  padding: 10px;
  border-radius: 5px;
  cursor: pointer;
 font-weight: 600;
                "
              >
            <i class="fa-solid fa-trash-can"></i>   Remove 
              </button>
            </form>
           
          </div>
        </div>
      <% }) %>
    </div>
  </main>
  <script src="/js/script.js"></script>
</body>
</html>