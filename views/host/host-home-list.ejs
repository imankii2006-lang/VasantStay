<%- include('../partials/head') %>
  <link rel="stylesheet" href="/css/home-list.css" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link rel="stylesheet" href="/css/navbar.css">
<link rel="stylesheet" href="/css/responsive.css">
</head>
<body>
  <%- include('../partials/nav') %>
  
  <main>
    <h1 class="welcome-text">Hey Host!  Here're your Homes:</h1>
    
    <div class="homes-container">
      <% RegisteredHomes.forEach(home => { %>
        <div class="home-card">
          <div class="image-container">
            <img src="<%= home.photo %>" alt="<%= home.housename %>">
          </div>
          <div class="home-details">
            <h2 class="house-name"><%= home.housename %></h2>
            <p class="location"><%= home.location %></p>
            <div class="price-rating">
              <span class="price">Rs<%= home.price %> / night</span>
              <span class="rating">⭐ <%= home.rating %></span>
            </div>
            <div style="display: flex; gap: 10px; margin-top: 15px;">
  
              <a href="/host/edit-home/<%= home._id %>?editing=true" 
                 class="book-btn" 
                 style="
                  background-color: #007bff; 
                  color: white; 
                  text-decoration: none; 
                  padding: 10px 0; 
                  border-radius: 8px; 
                  flex: 1; 
                  text-align: center; 
                  font-size: 14px; 
                  font-weight: 600;
                  transition: background 0.3s;
                 ">
                 Edit
              </a>
            
              <form action="/host/delete-home/<%= home._id %>" method="POST" style="flex: 1;">
                <button type="submit" 
                  class="book-btn" 
                  style="
                    background-color: #ff385c; 
                    color: white; 
                    border: none; 
                    padding: 10px 0; 
                    border-radius: 8px; 
                    width: 100%; 
                    cursor: pointer; 
                    font-size: 14px; 
                    font-weight: 600;
                    transition: background 0.3s;
                  ">
                  Delete
                </button>
              </form>
            
            </div>
           
          </div>
        </div>
      <% }) %>
    </div>
  </main>
  <script src="/js/script.js"></script>
</body>
</html>